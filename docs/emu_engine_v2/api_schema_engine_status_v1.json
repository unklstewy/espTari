{
  "schema_bundle": "espTari-v2-engine-status",
  "schema_version": "1.0.0",
  "api_version": "v2",
  "endpoint": {
    "method": "GET",
    "path": "/api/v2/engine/status"
  },
  "envelope_ref": "docs/emu_engine_v2/api_schema_envelope_v1.json",
  "query": {
    "required": ["session_id"],
    "types": {
      "session_id": "string"
    }
  },
  "data": {
    "required": ["session_id", "machine", "profile", "lifecycle_state", "run_mode", "snapshot_at_us", "uptime_ms", "cycle_counter", "tick_counter", "loaded_modules", "runtime"],
    "types": {
      "session_id": "string",
      "machine": "string",
      "profile": "string",
      "lifecycle_state": "enum(stopped|starting|running|paused|suspended|faulted|stopping)",
      "run_mode": "enum(realtime|slow_motion|single_step)",
      "snapshot_at_us": "uint64",
      "uptime_ms": "uint64",
      "cycle_counter": "uint64",
      "tick_counter": "uint64",
      "loaded_modules": "array",
      "runtime": "object"
    }
  },
  "runtime": {
    "required": ["scheduler_hz", "stream_health", "last_transition_at_us", "last_error"],
    "types": {
      "scheduler_hz": "uint32",
      "stream_health": "object",
      "last_transition_at_us": "uint64",
      "last_error": "object|null"
    }
  },
  "lifecycle_semantics": {
    "running": [
      "uptime_ms > 0",
      "counters increase between snapshots",
      "last_error is null unless non-fatal fault recorded"
    ],
    "paused": [
      "counters stable between snapshots",
      "run_mode unchanged",
      "last_transition_at_us equals pause timestamp"
    ],
    "suspended": [
      "counters stable",
      "stream_health may report disconnected outputs",
      "last_transition_at_us equals suspend timestamp"
    ],
    "faulted": [
      "counters may stop",
      "last_error must be non-null"
    ],
    "stopped": [
      "uptime_ms = 0",
      "counters may reset for next start sequence"
    ]
  },
  "consistency_rules": [
    "lifecycle_state must be one of section-12 states",
    "returned lifecycle_state must be reachable through allowed section-12 transitions",
    "unknown/inactive session identifiers must return ENGINE_NOT_RUNNING or NOT_FOUND"
  ],
  "examples": {
    "success": {
      "session_id": "ses_local",
      "machine": "atari_st",
      "profile": "st_520_pal",
      "lifecycle_state": "running",
      "run_mode": "realtime",
      "snapshot_at_us": 1710000007123,
      "uptime_ms": 39284,
      "cycle_counter": 102442933,
      "tick_counter": 409771732,
      "loaded_modules": [
        {
          "component": "cpu",
          "module_id": "st.cpu.m68k",
          "version": "2.0.0"
        }
      ],
      "runtime": {
        "scheduler_hz": 8000000,
        "stream_health": {
          "video": {"connected_clients": 1, "dropped_packets": 0},
          "audio": {"connected_clients": 1, "dropped_packets": 0}
        },
        "last_transition_at_us": 1710000004000,
        "last_error": null
      }
    }
  },
  "cross_links": {
    "api_spec": "docs/EMU_ENGINE_V2_API_SPEC.md",
    "api_spec_section": "6.6B",
    "task": "T-049"
  }
}
