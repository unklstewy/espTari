{
  "schema_bundle": "espTari-v2-lifecycle",
  "schema_version": "1.0.0",
  "api_version": "v2",
  "base_path": "/api/v2/engine",
  "envelope_ref": "docs/emu_engine_v2/api_schema_envelope_v1.json",
  "notes": "Endpoint sections define request fields and success data payloads; top-level envelope fields come from the canonical envelope schema.",
  "endpoints": {
    "session_start": {
      "method": "POST",
      "path": "/api/v2/engine/session",
      "request": {
        "required": ["machine", "profile", "rom_id"],
        "optional": ["disk_ids", "cartridge_id", "module_overrides", "stream_defaults", "input_defaults"],
        "types": {
          "machine": "string",
          "profile": "string",
          "rom_id": "string",
          "disk_ids": "string[]",
          "cartridge_id": "string|null",
          "module_overrides": "object",
          "stream_defaults": "object",
          "input_defaults": "object"
        }
      },
      "success_data": {
        "required": ["session_id", "state", "machine", "profile", "started_at_us"],
        "types": {
          "session_id": "string",
          "state": "enum(stopped|starting|running|paused|suspended|faulted)",
          "machine": "string",
          "profile": "string",
          "started_at_us": "uint64"
        }
      },
      "guard": {
        "allowed_current_states": ["stopped"],
        "invalid_transition_error": "INVALID_SESSION_STATE"
      }
    },
    "session_stop": {
      "method": "POST",
      "path": "/api/v2/engine/session/stop",
      "request": {
        "required": ["session_id"],
        "optional": ["reason"],
        "types": {
          "session_id": "string",
          "reason": "string"
        }
      },
      "success_data": {
        "required": ["session_id", "state", "stopped_at_us"],
        "types": {
          "session_id": "string",
          "state": "enum(stopped|starting|running|paused|suspended|faulted)",
          "stopped_at_us": "uint64"
        }
      },
      "guard": {
        "allowed_current_states": ["running", "paused", "suspended", "faulted"],
        "invalid_transition_error": "INVALID_SESSION_STATE"
      }
    },
    "session_pause": {
      "method": "POST",
      "path": "/api/v2/engine/session/pause",
      "request": {
        "required": ["session_id"],
        "optional": ["reason"],
        "types": {
          "session_id": "string",
          "reason": "string"
        }
      },
      "success_data": {
        "required": ["session_id", "state", "paused_at_us"],
        "types": {
          "session_id": "string",
          "state": "enum(stopped|starting|running|paused|suspended|faulted)",
          "paused_at_us": "uint64"
        }
      },
      "guard": {
        "allowed_current_states": ["running"],
        "invalid_transition_error": "INVALID_SESSION_STATE"
      }
    },
    "session_resume": {
      "method": "POST",
      "path": "/api/v2/engine/session/resume",
      "request": {
        "required": ["session_id"],
        "optional": ["resume_mode"],
        "types": {
          "session_id": "string",
          "resume_mode": "enum(running|paused)"
        }
      },
      "success_data": {
        "required": ["session_id", "state", "resumed_at_us"],
        "types": {
          "session_id": "string",
          "state": "enum(stopped|starting|running|paused|suspended|faulted)",
          "resumed_at_us": "uint64"
        }
      },
      "guard": {
        "allowed_current_states": ["paused", "suspended"],
        "invalid_transition_error": "INVALID_SESSION_STATE"
      }
    },
    "session_reset": {
      "method": "POST",
      "path": "/api/v2/engine/session/reset",
      "request": {
        "required": ["session_id"],
        "optional": ["mode", "preserve_media"],
        "types": {
          "session_id": "string",
          "mode": "enum(warm|cold)",
          "preserve_media": "boolean"
        }
      },
      "success_data": {
        "required": ["session_id", "state", "reset_mode", "preserve_media", "reset_at_us"],
        "types": {
          "session_id": "string",
          "state": "enum(stopped|starting|running|paused|suspended|faulted)",
          "reset_mode": "enum(warm|cold)",
          "preserve_media": "boolean",
          "reset_at_us": "uint64"
        }
      },
      "guard": {
        "allowed_current_states": ["running", "paused"],
        "invalid_transition_error": "INVALID_SESSION_STATE"
      }
    },
    "session_state_get": {
      "method": "GET",
      "path": "/api/v2/engine/session",
      "query": {
        "optional": ["session_id"],
        "types": {
          "session_id": "string"
        }
      },
      "success_data": {
        "required": ["session_id", "state", "snapshot_at_us", "uptime_ms", "runtime", "stream_health"],
        "types": {
          "session_id": "string",
          "state": "enum(stopped|starting|running|paused|suspended|faulted)",
          "snapshot_at_us": "uint64",
          "uptime_ms": "uint64",
          "runtime": "object",
          "stream_health": "object"
        }
      }
    },
    "session_status_get": {
      "method": "GET",
      "path": "/api/v2/engine/status",
      "success_data": {
        "required": ["session_state", "transition_count", "last_transition_us"],
        "types": {
          "session_state": "enum(stopped|starting|running|paused|suspended|faulted)",
          "transition_count": "uint64",
          "last_transition_us": "uint64"
        }
      }
    }
  },
  "canonical_errors": [
    "BAD_REQUEST",
    "INVALID_SESSION_STATE",
    "ENGINE_NOT_RUNNING",
    "ENGINE_ALREADY_RUNNING",
    "MACHINE_PROFILE_NOT_FOUND",
    "INTERNAL_ERROR"
  ],
  "examples": {
    "pause_request": {
      "session_id": "ses_local",
      "reason": "user_action"
    },
    "reset_request": {
      "session_id": "ses_local",
      "mode": "warm",
      "preserve_media": true
    },
    "session_state_success_data": {
      "session_id": "ses_local",
      "state": "running",
      "snapshot_at_us": 1710001234567,
      "uptime_ms": 4242,
      "runtime": {
        "scheduler_hz": 200,
        "timestamp_origin_us": 1710001230000,
        "timestamp_last_emitted_us": 1710001234567,
        "timestamp_regressions": 0,
        "last_transition_at_us": 1710001231000,
        "last_error": null
      },
      "stream_health": {
        "video": {
          "connected_clients": 0,
          "dropped_packets": 0
        },
        "audio": {
          "connected_clients": 0,
          "dropped_packets": 0
        }
      }
    }
  }
}
