{
  "bundle_id": "espTari-v2-api-baseline",
  "bundle_version": "1.0.0",
  "api_version": "v2",
  "status": "normative",
  "description": "Baseline control-plane API schema bundle with canonical envelope, canonical error taxonomy, lifecycle endpoint schemas, and example/cross-link index.",
  "artifacts": [
    {
      "id": "envelope",
      "path": "docs/emu_engine_v2/api_schema_envelope_v1.json",
      "role": "canonical success/error envelope + error taxonomy",
      "api_spec_sections": ["4", "5"]
    },
    {
      "id": "lifecycle",
      "path": "docs/emu_engine_v2/api_schema_lifecycle_v1.json",
      "role": "lifecycle endpoint request/response and guard schema set",
      "api_spec_sections": ["6.0", "6.1", "6.2", "6.3", "6.4", "6.5", "6.6", "6.6B", "12"]
    }
  ],
  "examples": {
    "session_start": {
      "request": {
        "machine": "atari_st",
        "profile": "st_520_pal",
        "rom_id": "tos_1_04"
      },
      "success_data": {
        "session_id": "ses_local",
        "state": "running",
        "machine": "atari_st",
        "profile": "st_520_pal",
        "started_at_us": 1710001000100
      },
      "api_spec_section": "6.1"
    },
    "session_reset": {
      "request": {
        "session_id": "ses_local",
        "mode": "warm",
        "preserve_media": true
      },
      "success_data": {
        "session_id": "ses_local",
        "state": "running",
        "reset_mode": "warm",
        "preserve_media": true,
        "reset_at_us": 1710001004567
      },
      "api_spec_section": "6.5"
    },
    "invalid_transition_error": {
      "error": {
        "code": "INVALID_SESSION_STATE",
        "category": "engine",
        "message": "Cannot pause session from state stopped",
        "retryable": false,
        "details": {
          "endpoint": "/api/v2/engine/session/pause",
          "current_state": "stopped",
          "allowed_states": ["running"],
          "requested_transition": "stopped->paused"
        }
      },
      "api_spec_section": "6"
    }
  },
  "cross_links": {
    "api_spec": "docs/EMU_ENGINE_V2_API_SPEC.md",
    "implementation_plan": "docs/EMU_ENGINE_V2_IMPLEMENTATION_PLAN.md",
    "indexed_spec_root": "docs/indexed/EMU_ENGINE_V2_API_SPEC/INDEX.md"
  }
}
