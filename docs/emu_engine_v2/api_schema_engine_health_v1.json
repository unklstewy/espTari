{
  "schema_bundle": "espTari-v2-engine-health",
  "schema_version": "1.0.0",
  "api_version": "v2",
  "endpoint": {
    "method": "GET",
    "path": "/api/v2/engine/health"
  },
  "envelope_ref": "docs/emu_engine_v2/api_schema_envelope_v1.json",
  "query": {
    "required": ["session_id"],
    "optional": ["components", "fail_on_unavailable"],
    "types": {
      "session_id": "string",
      "components": "csv<string>",
      "fail_on_unavailable": "boolean"
    }
  },
  "data": {
    "required": ["session_id", "overall_status", "overall_severity", "generated_at_us", "freshness_ttl_ms", "freshness_state", "components"],
    "types": {
      "session_id": "string",
      "overall_status": "enum(healthy|degraded|unavailable)",
      "overall_severity": "enum(info|warning|error|critical)",
      "generated_at_us": "uint64",
      "freshness_ttl_ms": "uint32",
      "freshness_state": "enum(fresh|stale)",
      "components": "component_health[]"
    }
  },
  "component_health": {
    "required": ["component", "status", "severity", "observed_at_us", "last_ok_at_us"],
    "optional": ["reason", "error_code"],
    "types": {
      "component": "string",
      "status": "enum(healthy|degraded|unavailable)",
      "severity": "enum(info|warning|error|critical)",
      "observed_at_us": "uint64",
      "last_ok_at_us": "uint64|null",
      "reason": "string",
      "error_code": "string"
    }
  },
  "freshness_rules": [
    "freshness_state=fresh iff (timestamp_us - generated_at_us) <= freshness_ttl_ms * 1000",
    "freshness_state=stale iff (timestamp_us - generated_at_us) > freshness_ttl_ms * 1000"
  ],
  "unavailable_subsystem_behavior": {
    "default_fail_on_unavailable": false,
    "ok_true_mode": {
      "condition": "fail_on_unavailable=false",
      "component_requirements": {
        "status": "unavailable",
        "severity": "error|critical",
        "error_code": "ENGINE_SUBSYSTEM_UNAVAILABLE"
      }
    },
    "error_mode": {
      "condition": "fail_on_unavailable=true and at least one requested component unavailable",
      "error_code": "ENGINE_SUBSYSTEM_UNAVAILABLE",
      "error_category": "engine"
    }
  },
  "examples": {
    "success": {
      "session_id": "ses_local",
      "overall_status": "degraded",
      "overall_severity": "warning",
      "generated_at_us": 1710000006123,
      "freshness_ttl_ms": 1000,
      "freshness_state": "fresh",
      "components": [
        {
          "component": "cpu",
          "status": "healthy",
          "severity": "info",
          "observed_at_us": 1710000006118,
          "last_ok_at_us": 1710000006118
        },
        {
          "component": "video",
          "status": "unavailable",
          "severity": "error",
          "observed_at_us": 1710000006119,
          "last_ok_at_us": 1710000005900,
          "reason": "video stream backend not initialized",
          "error_code": "ENGINE_SUBSYSTEM_UNAVAILABLE"
        }
      ]
    }
  },
  "cross_links": {
    "api_spec": "docs/EMU_ENGINE_V2_API_SPEC.md",
    "api_spec_section": "6.6A",
    "task": "T-048"
  }
}
