{
  "matrix_version": 1,
  "task_id": "S7-001",
  "sprint": "S7",
  "description": "Multi-machine profile baseline matrix with deterministic supported/blocked profile semantics",
  "checks": [
    {
      "id": "MM001_ATARI_ST_BASELINE_START",
      "request": "POST /api/v2/engine/session",
      "expect": {
        "http": 200,
        "machine": "atari_st",
        "profile": "st_520_pal",
        "manifest_schema_valid": true,
        "wiring_valid": true,
        "validated_modules": 5
      }
    },
    {
      "id": "MM002_SESSION_STATE_PARITY",
      "request": "GET /api/v2/engine/session",
      "expect": {
        "http": 200,
        "state": "running",
        "machine": "atari_st",
        "profile": "st_520_pal"
      }
    },
    {
      "id": "MM003_RESOLVE_BASELINE_COMPONENTS",
      "request": "POST /api/v2/ebins/resolve",
      "expect": {
        "http": 200,
        "machine": "atari_st",
        "components": [
          "cpu",
          "video"
        ]
      }
    },
    {
      "id": "MM004_MEGA_ST_MACHINE_GUARD",
      "request": "POST /api/v2/engine/session machine=mega_st profile=st_520_pal",
      "expect": {
        "http": 400,
        "error_code": "BAD_REQUEST",
        "reason": "machine/profile mismatch"
      }
    },
    {
      "id": "MM005_MEGA_ST_PROFILE_NOT_FOUND",
      "request": "POST /api/v2/engine/session machine=atari_st profile=mega_st_pal",
      "expect": {
        "http": 404,
        "error_code": "MACHINE_PROFILE_NOT_FOUND"
      }
    },
    {
      "id": "MM006_STE_PROFILE_NOT_FOUND",
      "request": "POST /api/v2/engine/session machine=atari_st profile=ste_pal",
      "expect": {
        "http": 404,
        "error_code": "MACHINE_PROFILE_NOT_FOUND"
      }
    },
    {
      "id": "MM007_MEGA_STE_PROFILE_NOT_FOUND",
      "request": "POST /api/v2/engine/session machine=atari_st profile=mega_ste_pal",
      "expect": {
        "http": 404,
        "error_code": "MACHINE_PROFILE_NOT_FOUND"
      }
    },
    {
      "id": "MM008_UNSUPPORTED_MACHINE_RESOLVE_GUARD",
      "request": "POST /api/v2/ebins/resolve machine=mega_st",
      "expect": {
        "http": 404,
        "error_code": "EBIN_NOT_FOUND",
        "reason": "resolver_machine_not_indexed"
      }
    }
  ]
}