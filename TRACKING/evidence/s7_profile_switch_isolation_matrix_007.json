{
  "matrix_version": 1,
  "task_id": "S7-007",
  "sprint": "S7",
  "description": "Profile-switch isolation and fallback guard validation matrix with post-switch control-plane operability checks",
  "checks": [
    {
      "id": "PS001_BASELINE_START_CONTEXT",
      "request": "POST /api/v2/engine/session machine=atari_st profile=st_520_pal",
      "expect": {
        "http": 200,
        "machine": "atari_st",
        "profile": "st_520_pal",
        "state": "running"
      }
    },
    {
      "id": "PS002_SWITCH_GUARD_STE",
      "request": "POST /api/v2/engine/session machine=atari_st profile=ste_pal",
      "expect": {
        "http": 404,
        "error_code": "MACHINE_PROFILE_NOT_FOUND"
      }
    },
    {
      "id": "PS003_SWITCH_GUARD_MEGA_STE",
      "request": "POST /api/v2/engine/session machine=atari_st profile=mega_ste_pal",
      "expect": {
        "http": 404,
        "error_code": "MACHINE_PROFILE_NOT_FOUND"
      }
    },
    {
      "id": "PS004_SWITCH_FALLBACK_MISMATCH",
      "request": "POST /api/v2/engine/session machine=mega_st profile=st_520_pal",
      "expect": {
        "http": 400,
        "error_code": "BAD_REQUEST",
        "reason": "machine/profile mismatch"
      }
    },
    {
      "id": "PS005_ISOLATION_STATE_PRESERVED",
      "request": "GET /api/v2/engine/session after guarded switch attempts",
      "expect": {
        "http": 200,
        "state": "running",
        "machine": "atari_st",
        "profile": "st_520_pal",
        "required_fields_preserved": true
      }
    },
    {
      "id": "PS006_POST_SWITCH_CONTROL_PLANE_OPERABLE",
      "request": "POST /api/v2/stream/control + GET /api/v2/stream/video + GET /api/v2/stream/audio",
      "expect": {
        "stream_control_http": 200,
        "video_http": 200,
        "audio_http": 200,
        "video_required_fields": true,
        "audio_required_fields": true
      }
    },
    {
      "id": "PS007_FALLBACK_GUARD_DETERMINISM",
      "request": "POST /api/v2/stream/control invalid pacing_mode + POST /api/v2/engine/session/stop then stream/control",
      "expect": {
        "invalid_control_http": 400,
        "invalid_control_code": "BAD_REQUEST",
        "stopped_control_http": 409,
        "stopped_control_code": "ENGINE_NOT_RUNNING"
      }
    },
    {
      "id": "PS008_POST_SWITCH_HEALTH_STATUS",
      "request": "GET /api/v2/engine/health + GET /api/v2/engine/session",
      "expect": {
        "health_http": 200,
        "health_ok": true,
        "session_http": 200,
        "profile_consistent": true
      }
    }
  ]
}
