[meta]
test_id = "test_input_policy_events_contract_T053"
task_id = "T-053"

[config]
timeout_s = 120
continue_on_failure = true

[[step]]
name = "input_policy_events_schema_present"
kind = "command"
command = '''python3 - <<'PY'
import json
from pathlib import Path
p = Path('docs/emu_engine_v2/api_schema_input_policy_events_v1.json')
d = json.loads(p.read_text(encoding='utf-8'))
assert d['stream']['event_type'] == 'input_policy_changed'
payload_required = set(d['payload']['required'])
for f in ['event_seq','event_timestamp_us','prior_state','new_state','requested_enabled','transition_result']:
    assert f in payload_required, f'missing payload field {f}'
ordering = '\n'.join(d.get('ordering_rules', []))
assert 'strictly monotonic' in ordering and 'source of truth is event_seq' in ordering
print('input_policy_events_schema=pass')
PY'''
expect_exit = [0]
expect_output_contains = ["input_policy_events_schema=pass"]

[[step]]
name = "input_policy_event_fields_present_in_runtime"
kind = "command"
command = '''python3 - <<'PY'
from pathlib import Path
src = Path('components/esptari_web/esptari_web_input.c').read_text(encoding='utf-8')
for token in [
    'policy_event_seq',
    'event_seq',
    'changed_at_us',
    'transition_result',
    'request_action',
    'mouse_over_pointer_in',
    'click_to_capture_acquired'
]:
    assert token in src, f'missing token: {token}'
print('input_policy_events_runtime=pass')
PY'''
expect_exit = [0]
expect_output_contains = ["input_policy_events_runtime=pass"]
