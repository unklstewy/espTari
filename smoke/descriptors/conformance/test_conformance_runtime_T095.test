[meta]
test_id = "test_conformance_runtime_T095"
task_id = "T-095"

[config]
base_url = "http://esptari.local"
auth_scope = "engine:control inspect:read input:write ebin:manage catalog:read catalog:write conformance:run conformance:write"
continue_on_failure = true

[[step]]
name = "engine_start"
method = "POST"
path = "/api/v2/engine/session/start"
body_json = '{}'
expect_status = [200, 409]

[[step]]
name = "manifest_load"
method = "POST"
path = "/api/v2/conformance/manifests/load"
body_json = '{"manifest_id":"mf_smoke_095","manifest":{"manifest_version":1,"target_machine":"atari_st","profile":"st_520_pal","suite":"smoke_095","cases":[{"case_id":"clock_step_contract","kind":"api","target":"/api/v2/debug/clock/step","assertions":["status_200"]}]}}'
expect_status = [200]

[[step]]
name = "harness_session"
method = "POST"
path = "/api/v2/conformance/harness/session"
body_json = '{"session_id":"ses_local","manifest_id":"mf_smoke_095","run_mode":"execute","evidence_level":"summary"}'
expect_status = [200, 409]
